# Copy to .env and fill in. Values set in claude_desktop_config.json take priority.

# Your Rent Manager corporate ID: the first part of https://{corpid}.api.rentmanager.com
RM_CORP_ID=yourcompany
# Or give the full API URL instead (only needed for a non-standard host)
# RM_API_BASE_URL=https://yourcompany.api.rentmanager.com

# A dedicated Rent Manager API user (Rent Manager must enable API access for your account)
RM_USERNAME=api-user
RM_PASSWORD=change-me

# Location to log in to (usually 1)
RM_LOCATION_ID=1

# Optional: use a pre-issued token instead of logging in. If it expires the server
# can only recover when RM_USERNAME/RM_PASSWORD are also set.
# RM_API_TOKEN=

# Optional: set to true to hide add_tenant_note and create_work_order
RM_READ_ONLY=false

# Optional: default HistoryCategoryID for new tenant notes, if your setup requires one
# RM_NOTE_CATEGORY_ID=

# Optional: request timeout in seconds (default 30)
# RM_TIMEOUT_SECONDS=30

# ── Hosted team mode only (node dist/index.js --http). See docs/TEAM_SETUP.md ──
# PUBLIC_URL=https://rent-manager-mcp.onrender.com   (Render fills this in automatically)
# PORT=3000
# AUTH_SECRET=a-long-random-string-of-at-least-32-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_DOMAINS=yourcompany.com
# ALLOWED_EMAILS=
# EDITOR_EMAILS=you@yourcompany.com
# EXTRA_REDIRECT_HOSTS=   (only if Claude's sign-in callback moves to a new host)

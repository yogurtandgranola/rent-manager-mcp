# Rent Manager API configuration
# Copy this file to .env and fill in your values.

# Your Rent Manager API base URL (required)
# Usually: https://<yourcompany>.api.rentmanager.com
RM_API_BASE_URL=https://yourcompany.api.rentmanager.com

# Option A: API token (preferred — create one in Rent Manager under API access)
RM_API_TOKEN=

# Option B: Username/password (used only if RM_API_TOKEN is empty)
RM_USERNAME=
RM_PASSWORD=

# Your Rent Manager location ID (defaults to 1)
RM_LOCATION_ID=1

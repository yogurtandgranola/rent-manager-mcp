# Your Rent Manager API base URL (no trailing slash)
# For Rent Manager Online this is typically https://{yourcorp}.api.rentmanager.com
RM_API_BASE_URL=https://yourcompany.api.rentmanager.com

# Option A: API Token (skips the AuthorizeUser call)
#RM_API_TOKEN=your-api-token-here

# Option B: Username/Password (server calls /Authentication/AuthorizeUser
# and passes the returned token in the X-RM12Api-ApiToken header)
RM_USERNAME=your-username
RM_PASSWORD=your-password

# Your location ID (most single-database accounts use 1)
RM_LOCATION_ID=1
